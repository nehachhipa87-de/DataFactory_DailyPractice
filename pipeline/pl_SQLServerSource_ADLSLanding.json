{
	"name": "pl_SQLServerSource_ADLSLanding",
	"properties": {
		"activities": [
			{
				"name": "LookupSQLServerControlTable",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_SqlServerTables_Param",
						"type": "DatasetReference",
						"parameters": {
							"pDsServerName": "localhost\\SQLEXPRESS",
							"pDsDatabaseName": "dev_clintrail_edc_src",
							"pDsSchemaName": "edcsrcmetadata",
							"pDsTableName": "srcEdcClintrailToLandControl"
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ForEach_Src_Landing",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "LookupSQLServerControlTable",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('LookupSQLServerControlTable').output.value",
						"type": "Expression"
					},
					"isSequential": false,
					"activities": [
						{
							"name": "Copy_SqlServer_Landing",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 3,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "SqlServerSource",
									"sqlReaderQuery": {
										"value": "@if(\r\n    equals(item().IngestionType, 'Incremental'),\r\n    concat(\r\n        'SELECT * FROM ',\r\n        item().SrcSchemaName,\r\n        '.',\r\n        item().SrcTableName,\r\n        ' WHERE ',\r\n        item().WatermarkColName,\r\n        ' > ''',\r\n        string(item().WatermarkColValue),\r\n        ''''\r\n    ),\r\n    concat(\r\n        'SELECT * FROM ',\r\n        item().SrcSchemaName,\r\n        '.',\r\n        item().SrcTableName\r\n    )\r\n)",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"sink": {
									"type": "ParquetSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "ParquetWriteSettings"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "ds_SqlServerTables_Param",
									"type": "DatasetReference",
									"parameters": {
										"pDsServerName": {
											"value": "@item().SrcServerName",
											"type": "Expression"
										},
										"pDsDatabaseName": {
											"value": "@item().SrcDatabaseName",
											"type": "Expression"
										},
										"pDsSchemaName": {
											"value": "@item().SrcSchemaName",
											"type": "Expression"
										},
										"pDsTableName": {
											"value": "@item().SrcTableName",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "ds_adls_clintrail_dev_param",
									"type": "DatasetReference",
									"parameters": {
										"pDsContainerName": {
											"value": "@item().LandingContainerName",
											"type": "Expression"
										},
										"pDsFolderName": {
											"value": "@concat(item().SrcSchemaName,'/',item().SrcTableName,'/ingest_date=',formatDateTime(utcNow(),'yyyy-MM-dd'))",
											"type": "Expression"
										},
										"pDsFileName": {
											"value": "@concat(item().SrcTableName,'_',formatDateTime(utcNow(),'yyyyMMddHHmmss'), '.parquet')",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			}
		],
		"folder": {
			"name": "dev_clintrail/SQLServerSource_ADLS_Landing"
		},
		"annotations": []
	}
}